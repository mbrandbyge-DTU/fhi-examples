    species        Ti
  #     global species definitions
      nucleus             22
      mass                47.867
  #
      l_hartree           4
  #
      cut_pot             3.5          1.5  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         48 5.0
      radial_multiplier   1
      angular_grids       specified
        division   0.5171   50
        division   0.9824  110
        division   1.2917  194
        division   1.4940  302
